<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ie.broadsheet.app</groupId>
  <artifactId>Broadsheet.ie-Android-tests</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>SkillPages (Test Build)</name>

  <properties>
    <android.version>4.1.1.4</android.version>
    <robospice.google.http.client.version>1.4.5</robospice.google.http.client.version>
    <google.http.client.version>1.15.0-rc</google.http.client.version>
    <commons.logging.version>1.1.3</commons.logging.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Stubs for Android framework classes and libraries not on Maven Central.
         Must appear BEFORE android.jar so that working implementations of
         BaseAdapter, ArrayAdapter etc. shadow the Stub!-throwing versions
         in android.jar. Installed to local repo from libs/stubs.jar. -->
    <dependency>
      <groupId>ie.broadsheet.stubs</groupId>
      <artifactId>android-lib-stubs</artifactId>
      <version>1.0</version>
    </dependency>

    <dependency>
      <groupId>com.google.android</groupId>
      <artifactId>android</artifactId>
      <version>${android.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.octo.android.robospice</groupId>
      <artifactId>robospice-google-http-client</artifactId>
      <version>${robospice.google.http.client.version}</version>
      <exclusions>
        <exclusion>
          <artifactId>support-v4</artifactId>
          <groupId>com.google.android</groupId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.google.http-client</groupId>
      <artifactId>google-http-client-jackson</artifactId>
      <version>${google.http.client.version}</version>
      <exclusions>
        <exclusion>
          <groupId>xpp3</groupId>
          <artifactId>xpp3</artifactId>
        </exclusion>
        <exclusion>
          <groupId>stax</groupId>
          <artifactId>stax-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>commons-logging</groupId>
      <artifactId>commons-logging</artifactId>
      <version>${commons.logging.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.nostra13.universalimageloader</groupId>
      <artifactId>universal-image-loader</artifactId>
      <version>1.8.4</version>
    </dependency>

    <!-- Test dependencies -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.12</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-inline</artifactId>
      <version>2.28.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src</sourceDirectory>
    <testSourceDirectory>src/test/java</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.1</version>
        <configuration>
          <source>1.6</source>
          <target>1.6</target>
          <excludes>
            <!-- Exclude test sources from main compilation (they live under src/) -->
            <exclude>test/**</exclude>
            <!-- Activities with complex UI deps we don't need for the test -->
            <exclude>ie/broadsheet/app/CommentListActivity.java</exclude>
            <exclude>ie/broadsheet/app/PostDetailActivity.java</exclude>
            <exclude>ie/broadsheet/app/PostListActivity.java</exclude>
            <!-- Adapter not under test -->
            <exclude>ie/broadsheet/app/adapters/CommentAdapter.java</exclude>
            <!-- Dialogs -->
            <exclude>ie/broadsheet/app/dialog/AboutDialog.java</exclude>
            <exclude>ie/broadsheet/app/dialog/MakeCommentDialog.java</exclude>
            <exclude>ie/broadsheet/app/dialog/TipDialog.java</exclude>
            <exclude>ie/broadsheet/app/dialog/WebViewDialog.java</exclude>
            <!-- Fragments -->
            <exclude>ie/broadsheet/app/fragments/PostDetailFragment.java</exclude>
            <exclude>ie/broadsheet/app/fragments/PostListFragment.java</exclude>
            <!-- Requests not under test -->
            <exclude>ie/broadsheet/app/requests/MakeCommentRequest.java</exclude>
            <exclude>ie/broadsheet/app/requests/SubmitTipRequest.java</exclude>
            <exclude>ie/broadsheet/app/requests/DownloadFileRequest.java</exclude>
            <exclude>ie/broadsheet/app/requests/PostRequest.java</exclude>
            <!-- HTTP client helper with extra deps -->
            <exclude>ie/broadsheet/app/client/http/MultipartFormDataContent.java</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>2.17</version>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
